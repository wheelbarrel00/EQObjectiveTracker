## Interface: 11509
## Title: EQ Objective Tracker
## Notes: Standalone replacement for the default objective tracker.
## Author: Wheelbarrel00
## Version: 1.14.0
## SavedVariables: EQObjectiveTrackerDB
## X-Curse-Project-ID: 1637002
## X-Website: https://github.com/wheelbarrel00/EQObjectiveTracker
## Category: Quests & Leveling

# Libraries (vendored, never .pkgmeta externals - a fresh checkout must load as-is)
Libs\LibStub\LibStub.lua
Libs\CallbackHandler-1.0\CallbackHandler-1.0.xml
Libs\AceDB-3.0\AceDB-3.0.xml
Libs\LibSharedMedia-3.0\lib.xml

# Locales. enUS creates ns.L and must load before any consumer. The rest only add
# translations. Every Locales file is GENERATED from ../EverythingLocales by scan.py and
# build.py - never hand-edit one.
Locales\enUS.lua
Locales\frFR.lua
Locales\ruRU.lua
Locales\koKR.lua
Locales\zhCN.lua
Locales\zhTW.lua
Locales\deDE.lua

# Core. Init defines RegisterModule and must load first, Compat second.
Core\Init.lua
Core\Compat.lua
Core\Events.lua
Core\Util.lua
Core\API.lua
Core\Media.lua
Core\DB.lua
Core\Migrate.lua
Core\Changelog.lua

# Data layer. Operates on normalized entries and game APIs, never on frames.
Data\Entry.lua
Data\Registry.lua
Data\Focus.lua
Data\TrackedSet.lua
Data\Filter.lua
Data\Sort.lua
Data\ManualOrder.lua
Data\Distance.lua
Data\Feed.lua
Data\WatchPersist.lua
Data\SuperTrackPersist.lua
Data\AutoTrack.lua
Data\QuestSound.lua
Data\QuestItems.lua
Data\QuestRewards.lua
Data\AutoQuestPopups.lua
Data\ZoneRouting.lua
Data\ZoneProgress.lua
Data\ScenarioBonus.lua
Data\Widgets.lua
Data\QuestGroups.lua

# Providers. THE ONLY FLAVOR-VARYING SECTION OF THIS FILE. World quests are Legion and
# later, endeavors are the retail Traveler's Log, and tracked recipes need the retail
# profession API. The quest log here is index driven and lives on flat globals rather
# than C_QuestLog, so it gets its own provider - measured on 1.15.9 and 2.5.6.
Data\Providers\QuestsClassic.lua

# Display layer. Operates on frames, never on a quest API.
UI\Blizzard.lua
UI\QuestieCoexist.lua
UI\QuestLogChecks.lua
UI\RowPool.lua
UI\Card.lua
UI\DragDrop.lua
UI\Row.lua
UI\RowMenu.lua
UI\ItemButtons.lua
UI\AutoQuestPopup.lua
UI\Sections.lua
UI\Scenario.lua
UI\WidgetBlock.lua
UI\ScenarioSpells.lua
UI\Tracker.lua
UI\TaxiHighlight.lua
UI\ZoneProgressBar.lua
UI\RewardTooltip.lua
UI\ScenarioBonusHUD.lua
UI\Visibility.lua
UI\Dialog.lua

# Options. Frame.lua defines RegisterTab and must load before any Tab file.
Options\Frame.lua
Options\TabGeneral.lua
Options\TabTracker.lua
Options\TabAppearance.lua
Options\TabAbout.lua

# Temporary cross-flavor measurement command. Remove with its dispatcher branch
# in UI\Commands.lua, or keep it deliberately, before the first Classic release.
UI\FlavorProbe.lua
UI\Commands.lua
